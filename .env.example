# Telegram
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=
ALLOWED_CHAT_IDS=
TRIGGER_MODE=mention_or_reply
POLL_TIMEOUT_SECONDS=30
STORE_PASSIVE_MESSAGES=1
AUTONOMOUS_REPLY=0
AUTONOMOUS_REPLY_MIN_SECONDS=300
AUTONOMOUS_REPLY_MAX_PER_HOUR=3
DEFAULT_LANGUAGE=auto
CHAT_LANGUAGE_MODE=auto
CHAT_LANGUAGE_OVERRIDES=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_WEB_SEARCH=1
OPENAI_WEB_SEARCH_TOOL=web_search
SYSTEM_PROMPT=你是一个在 Telegram 群里工作的中文 AI 助手。回答要简洁、直接、可执行；不知道就说不知道。
MAX_CONTEXT_MESSAGES=12
MOCK_AI=0

# News
NEWS_ENABLED=0
NEWS_CHAT_IDS=
NEWS_INTERVAL_MINUTES=360
NEWS_COUNT=3
NEWS_KEYWORDS=
NEWS_RSS_FEEDS=https://feeds.bbci.co.uk/news/world/rss.xml,https://www.theguardian.com/world/rss,https://rss.nytimes.com/services/xml/rss/nyt/World.xml,https://hnrss.org/frontpage
NEWS_CARD_MODE=card
NEWS_AI_SUMMARY=0
NEWS_WITH_POLL=0
NEWS_DISCUSSION_MAP=

# Engagement
LEADERBOARD_ENABLED=0
LEADERBOARD_CHAT_IDS=
LEADERBOARD_INTERVAL_HOURS=168
LEADERBOARD_DAYS=7

# Storage
DATABASE_PATH=data/bot.sqlite3
